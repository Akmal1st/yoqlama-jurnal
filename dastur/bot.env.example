# Shu faylni "bot.env" nomi bilan nusxalang va to'ldiring (bot.env ni hech kimga yubormang).
TELEGRAM_BOT_TOKEN=            # @BotFather → /newbot dan olingan token
ADMIN_IDS=                     # admin Telegram ID'si (@userinfobot ga /start yuboring); vergul bilan bir nechta
ALLOWED_IDS=                   # ixtiyoriy: tasdiqsiz to'liq ruxsat berilganlar (ADMIN_IDS bo'sh bo'lsa, shular admin bo'ladi)
JURNAL_FILE=                   # ixtiyoriy: journal.json yo'li (adminning hisobotlari uchun xavf mezonlari va PDF dizayni; faqat o'qiladi)
